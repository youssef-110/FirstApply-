# Copy to .env for local development. Never commit .env.
# Without DATABASE_URL, local data is stored in an embedded Postgres (data/pglite).

# DATABASE_URL=postgres://...            Neon connection string (production)
RESEND_API_KEY=
MAIL_FROM="Firstapply <onboarding@resend.dev>"

SESSION_SECRET=                           # 32+ random characters
CRON_SECRET=                              # 32+ random characters
ADMIN_EMAIL=                              # your account: gets the admin view, owns the first alert
# APP_URL=http://localhost:4380           public URL, used for links in emails
# DIGEST_HOUR=8                           hour (Berlin time) for daily-digest alerts
# QSTASH_TOKEN=                           set by the Upstash QStash integration on Vercel
